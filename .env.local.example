# =================================================================
# FlexiBuckets — Self-Hosted Environment Configuration
# =================================================================
# Copy this file to .env and fill in the values.
# Run the install script for automatic setup:
#   Linux/Mac: bash self-host-install.sh
#   Windows:   powershell -ExecutionPolicy Bypass -File self-host-install.ps1
# =================================================================

# --- Deployment Mode ---
DEPLOYMENT_MODE=local
COMPOSE_FILE=docker-compose.local.yml

# --- Database Configuration ---
# OPTION 1: Bundled PostgreSQL (uncomment COMPOSE_PROFILES and POSTGRES_* vars)
# COMPOSE_PROFILES=fullstack
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<generate-a-strong-password>
# POSTGRES_DB=flexibuckets
# DATABASE_URL=postgresql://postgres:<your-password>@db:5432/flexibuckets

# OPTION 2: External / Cloud PostgreSQL (Supabase, Neon, RDS, etc.)
# DATABASE_URL=postgresql://user:password@your-cloud-host:5432/dbname

# --- Application Secrets ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NODE_ENV=production

# --- Port Configuration ---
# Change if port 3000 is already in use
# APP_PORT=3000

# --- Version (auto-populated by install script) ---
# APP_VERSION=latest
# APP_SHA_SHORT=latest
